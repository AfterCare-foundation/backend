# AfterCare Backend — Environment Variables
# Copy this file to .env and fill in the values.
# .env is in .gitignore — never commit it.
# One line per setting in app/config.py (a test keeps them in step).
# An older .env must not contain FRIENDLY_CAPTCHA_SECRET or CAPTCHA_SKIP any more:
# delete both lines, or startup fails (unknown settings in .env are rejected).

DATABASE_URL=postgresql://aftercare_dev:aftercare_dev_password@localhost:5432/aftercare_dev

# Required: development or production (anything else stops startup).
# development enables /docs and /openapi.json. production turns them off and
# refuses to start unless PUSH_STUB_MODE=false, APNS_PRODUCTION=true,
# APNS_KEY_ID and APNS_TEAM_ID are set, and an APNs key is given (APNS_KEY or APNS_KEY_FILE).
ENVIRONMENT=development

# Start dispatcher + TTL cleanup in this process. With several processes on one
# database only one runs each job at a time; set false on extra web workers.
RUN_BACKGROUND_JOBS=true

APNS_KEY_ID=your_key_id_here
APNS_KEY_FILE=secrets/apns_key.p8
# Or paste the .p8 text here instead (for hosts without secret files). Never commit it. Empty: use APNS_KEY_FILE.
APNS_KEY=
APNS_TEAM_ID=your_team_id_here
APNS_BUNDLE_ID=eu.after-care.app
# false: Apple's sandbox (Xcode builds). Must be true when ENVIRONMENT=production.
APNS_PRODUCTION=false

FCM_SERVICE_ACCOUNT_FILE=secrets/fcm_service_account.json
# true: do not call Apple/Google; pushes are only logged as counts. Must be false when ENVIRONMENT=production.
PUSH_STUB_MODE=true

# Days a card scan is kept before automatic deletion (existing rows too).
SUBSCRIPTION_TTL_DAYS=180

# Days a dead push token is kept before it is wiped. The subscription itself stays.
DEAD_TOKEN_GRACE_DAYS=30

# New connections one device may add per day (stops mass-registering photographed cards).
MAX_SUBSCRIPTIONS_PER_DAY=30

# Days a notification waits in the recipient's mailbox for the app to fetch it.
MAILBOX_TTL_DAYS=30

# Window, in days, for the campaign limit below.
NOTIFY_RATE_LIMIT_DAYS=30
# Most notification campaigns one device may start inside that window.
NOTIFY_MAX_CAMPAIGNS=6
# Most campaigns one device may start in a rolling 24 hours.
NOTIFY_MAX_CAMPAIGNS_PER_DAY=3
# Most contacts one campaign may notify.
NOTIFY_MAX_CONTACTS_PER_CAMPAIGN=100
